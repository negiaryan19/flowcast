FLOWCAST_MODEL_PATH=artifacts/traffic_volume_1h.joblib
FLOWCAST_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FLOWCAST_AUTH_DB=artifacts/accounts.sqlite3
# Enable only when the application is served over HTTPS.
FLOWCAST_COOKIE_SECURE=false
# Optional Supabase/PostgreSQL Session Pooler URI. When unset, FlowCast uses local SQLite.
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
